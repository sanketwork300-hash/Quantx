# ---------------------------------------------------------------- application
QIP_ENV=development
QIP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
QIP_ACCESS_TOKEN_TTL_MINUTES=60
QIP_LOG_LEVEL=INFO
QIP_LOG_FORMAT=json          # json | console

# ------------------------------------------------------------------ database
QIP_DATABASE_URL=postgresql+asyncpg://qip:qip@postgres:5432/qip

# --------------------------------------------------------------------- cache
QIP_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- job queue
QIP_CELERY_BROKER_URL=redis://redis:6379/1
QIP_CELERY_RESULT_BACKEND=redis://redis:6379/2
# EAGER runs jobs inline in the API process. Only for local dev / tests.
QIP_JOB_EXECUTION_MODE=queue   # queue | eager

# ------------------------------------------------------------- object store
QIP_OBJECT_STORE_BACKEND=local   # local | s3
QIP_OBJECT_STORE_ROOT=/var/qip/objectstore
QIP_S3_ENDPOINT_URL=http://minio:9000
QIP_S3_BUCKET=qip
QIP_S3_ACCESS_KEY=minioadmin
QIP_S3_SECRET_KEY=minioadmin

# ------------------------------------------------------------------ uploads
QIP_MAX_UPLOAD_BYTES=52428800     # 50 MiB
QIP_MAX_UPLOAD_ROWS=500000

# ----------------------------------------------------------------- frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
