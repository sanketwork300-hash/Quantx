# ---------------------------------------------------------------- application
QIP_ENV=development
QIP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
QIP_ACCESS_TOKEN_TTL_MINUTES=60
QIP_LOG_LEVEL=INFO
QIP_LOG_FORMAT=json          # json | console

# ------------------------------------------------------------------ database
QIP_DATABASE_URL=postgresql+asyncpg://qip:qip@postgres:5432/qip

# --------------------------------------------------------------------- cache
QIP_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- job queue
QIP_CELERY_BROKER_URL=redis://redis:6379/1
QIP_CELERY_RESULT_BACKEND=redis://redis:6379/2
# EAGER runs jobs inline in the API process. Only for local dev / tests.
QIP_JOB_EXECUTION_MODE=queue   # queue | eager

# ------------------------------------------------------------- object store
QIP_OBJECT_STORE_BACKEND=local   # local | s3
QIP_OBJECT_STORE_ROOT=/var/qip/objectstore
QIP_S3_ENDPOINT_URL=http://minio:9000
QIP_S3_BUCKET=qip
QIP_S3_ACCESS_KEY=minioadmin
QIP_S3_SECRET_KEY=minioadmin

# ------------------------------------------------------------------ uploads
QIP_MAX_UPLOAD_BYTES=52428800     # 50 MiB
QIP_MAX_UPLOAD_ROWS=500000

# ---------------------------------------------------- live market data
# synthetic | csv | upstox. There is no automatic fallback: a deployment
# configured for a live provider that cannot be built fails to start, because
# serving generated prices as real ones is the worst thing this platform could
# do. A production-like environment refuses to build the synthetic provider at all.
QIP_MARKET_DATA_PROVIDER=synthetic
QIP_MARKET_DATA_CSV_ROOT=

# Whose broker connection the shared feed uses. Market data is one entitlement
# for the deployment rather than one per user, so the account is named. It is
# also the account whose licensing terms govern what may be shown to whom.
QIP_MARKET_DATA_ACCOUNT_EMAIL=

# polling | websocket.
#   polling   — asks the provider's REST API every interval. Verified end to
#               end here, works against any provider with a quote endpoint, and
#               states its own sampling rate rather than implying every tick.
#   websocket — holds the provider's feed open. Needs a decoder for their wire
#               format; see QIP_UPSTOX_FEED_PROTO_MODULE below.
QIP_MARKET_STREAM_TRANSPORT=polling
QIP_MARKET_STREAM_POLL_INTERVAL_SECONDS=1.0
# A connection that is up but silent for this long is reported STALE rather
# than read as a quiet market.
QIP_MARKET_STREAM_STALE_AFTER_SECONDS=30
# A live quote that stops being refreshed disappears rather than being served
# indefinitely as though the feed were still running.
QIP_LIVE_QUOTE_TTL_SECONDS=300
QIP_LIVE_SUBSCRIPTION_TTL_SECONDS=900

QIP_UPSTOX_API_BASE_URL=https://api.upstox.com
# The complete file covers every listed instrument on every segment. Narrow it.
QIP_UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
QIP_UPSTOX_INSTRUMENT_SEGMENTS=NSE_INDEX,NSE_EQ,NSE_FO
QIP_UPSTOX_INSTRUMENT_UNDERLYINGS=
# Multiplies the provider's published tick size. 1 reports what they reported;
# change it once the unit has been verified against their documentation.
QIP_UPSTOX_TICK_SIZE_SCALE=1.0

# The feed socket address is not configured because the provider does not
# publish a fixed one: this authorize call returns a short-lived URL.
QIP_UPSTOX_FEED_AUTHORIZE_URL=https://api.upstox.com/v3/feed/market-data-feed/authorize
QIP_UPSTOX_FEED_MODE=full
# Dotted path to the protobuf module generated from the provider's own .proto
# (`protoc --python_out=. MarketDataFeedV3.proto`). This platform does not ship
# a reimplementation of a provider's wire format, so the websocket transport
# will not start without it.
QIP_UPSTOX_FEED_PROTO_MODULE=
QIP_UPSTOX_FEED_PROTO_MESSAGE=FeedResponse

# -------------------------------------------------- broker connections
# Broker access tokens are NOT configured here. A user connects a broker from
# the Connections page, the token is exchanged through the provider's own login
# and stored encrypted in the database, and it is refreshed without anyone
# editing this file. What lives here is the app registration, which is issued
# once and does not rotate.
#
# Generate the encryption key with:
#   python scripts/generate_credential_key.py
# Without it the platform refuses to store broker credentials at all rather
# than holding them in the clear.
QIP_CREDENTIAL_ENCRYPTION_KEYS=
QIP_OAUTH_STATE_TTL_MINUTES=10
QIP_CREDENTIAL_REFRESH_SKEW_SECONDS=120

# Upstox app registration (https://account.upstox.com/developer/apps). The
# redirect URI must be the frontend callback and must match the app exactly.
QIP_UPSTOX_CLIENT_ID=
QIP_UPSTOX_CLIENT_SECRET=
QIP_UPSTOX_REDIRECT_URI=http://localhost:3000/connections/callback
# Endpoints are configuration, not constants: verify them against the
# provider's current API documentation before deploying.
QIP_UPSTOX_AUTHORIZE_URL=https://api.upstox.com/v2/login/authorization/dialog
QIP_UPSTOX_TOKEN_URL=https://api.upstox.com/v2/login/authorization/token

# ----------------------------------------------------------------- frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
